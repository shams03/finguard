APP_ENV=development
BIND_ADDR=127.0.0.1:8080
# Allowed browser origin (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# --- Database (local Docker). In production set this to your Supabase
# direct / session-pooler URL with ?sslmode=require. See README.
DATABASE_URL=postgres://finguard:finguard@localhost:5432/finguard
# Optional: use a direct (non-pooled) URL for migrations
DATABASE_MIGRATION_URL=
DATABASE_MAX_CONNECTIONS=10
# Set to 0 only if you must use the Supabase *transaction* pooler (port 6543)
DATABASE_STATEMENT_CACHE=

# --- Jev (JevStation by default; official TypeSafe URL also supported) ---
JEVSTATION_API_KEY=
JEVSTATION_BASE_URL=https://jevstation.com/api/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=10000
JEV_DEFAULT_CONFIDENCE_THRESHOLD=0.85
# Per-risk-class thresholds (demo values, NOT validated financial thresholds)
JEV_THRESHOLD_READ_ONLY=0.70
JEV_THRESHOLD_REVERSIBLE=0.80
JEV_THRESHOLD_MONEY_MOVEMENT=0.90
JEV_THRESHOLD_HIGH_IMPACT=0.95

# --- Groq ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=15000
# true = response_format json_schema strict. false = JSON mode + server validation
GROQ_STRICT_SCHEMA=true

# --- Behaviour switches ---
# deterministic = offline regex parser; groq = LLM parser (falls back to deterministic)
INTENT_PARSER=deterministic
# real = call Jev; mock = scripted offline assessments
DECISION_PROVIDER=mock
# real | mock
ESCALATION_ANALYZER=mock

RUST_LOG=info,finguard=debug,sqlx=warn
